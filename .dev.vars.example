# Copia este archivo a .dev.vars para correr en local (nunca se sube a git).

# 1 = modo simulación: QR falsos y botón "Simular pago" en la demo. Nunca en producción.
SIMULACION=1

# Clave para entrar al portal del dueño.
PORTAL_TOKEN=cambia-esta-clave
# Clave de solo lectura para el jurado (opcional): ve ventas y máquinas, no cambia nada ni ve a los interesados.
JURADO_TOKEN=cambia-esta-otra-clave

# Secreto con el que pey firma los avisos (formato whsec_<base64>). En producción se copia del portal de pey.
PEY_WEBHOOK_SECRET=whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw

# API key de pey. Vacía = los QR se simulan.
PEY_API_KEY=
