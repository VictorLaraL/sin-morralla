{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sin-morralla",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-23",
  // La consulta larga del ESP32 deja de leer D1 si el módulo corta la conexión (request.signal).
  "compatibility_flags": ["enable_request_signal"],

  // Landing, demo y portal: archivos estáticos. Las rutas /api, /webhooks y /device las atiende el Worker.
  "assets": {
    "directory": "./web",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sin-morralla",
      // Base creada con `wrangler d1 create sin-morralla --location wnam`. Para tu propia cuenta, crea la tuya y cambia el id.
      "database_id": "83402b76-1883-4ad8-b7b7-6a5ad3614db7",
      "migrations_dir": "migrations"
    }
  ],

  // Difusor: reparte en vivo los pagos a la landing y al portal con WebSockets en hibernación.
  "durable_objects": {
    "bindings": [{ "name": "DIFUSOR", "class_name": "Difusor" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Difusor"] }],

  // Cada minuto: vence los créditos que la máquina no recogió a tiempo.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "TTL_CREDITO_MIN": "10"
  },

  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
